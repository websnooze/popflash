# Server
PORT=5004
NODE_ENV=development
PUBLIC_URL=http://localhost:5004
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_URL=postgres://user:password@localhost:5432/fragstack

# Redis (pub/sub WS, ready-check, locks, session cache, rate limits)
REDIS_URL=redis://default:password@localhost:6379/0

# Auth
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
STEAM_API_KEY=your-steam-web-api-key
COOKIE_NAME=fragstack_session

# DatHost
DATHOST_EMAIL=you@example.com
DATHOST_PASSWORD=your-dathost-password
DATHOST_TEMPLATE_SERVER_ID=your-cs2-template-server-id
DATHOST_WEBHOOK_SECRET=change-me-webhook-shared-secret
